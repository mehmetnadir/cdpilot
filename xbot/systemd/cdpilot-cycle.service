[Unit]
Description=cdpilot Twitter cycle (mention/discovery/analytics)
After=network.target

[Service]
Type=oneshot
Environment=CDPILOT_XBOT_DATA=/opt/cdpilot-twitter-bot
Environment=CDPILOT_TELEGRAM_ENV=/opt/cdpilot-twitter-bot/telegram.env
Environment=CDPILOT_FAZ=0.5
ExecStart=/opt/cdpilot-twitter-bot/twikit-venv/bin/python /opt/cdpilot-twitter-bot/ops/run_cycle.py auto
StandardOutput=append:/opt/cdpilot-twitter-bot/logs/cycle.log
StandardError=append:/opt/cdpilot-twitter-bot/logs/cycle.log
